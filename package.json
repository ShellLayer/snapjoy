{
  "name": "snapjoy",
  "version": "1.4.0",
  "description": "SnapJoy 拾光相机 · 在电脑上留下一点好心情",
  "author": "ShellLayer",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ShellLayer/snapjoy.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win nsis portable --x64",
    "pack:mac": "electron-builder --mac --dir --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "smoke:package": "node tools/smoke-package.cjs",
    "sync-vendor": "node tools/sync-vendor.cjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "studio.lumi.booth",
    "productName": "拾光相机",
    "directories": {
      "output": "release/1.4.0"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.photography",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "SnapJoy-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "SnapJoy 使用摄像头预览、拍照和录像，画面与作品仅在本机处理和保存。",
        "NSMicrophoneUsageDescription": "仅在您勾选「录制声音」后，SnapJoy 才会使用麦克风录制视频声音，并在停止录像时释放。"
      }
    },
    "dmg": {
      "title": "SnapJoy 拾光相机",
      "sign": false
    },
    "portable": {
      "artifactName": "SnapJoy-${version}-Windows.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SnapJoy 拾光相机",
      "artifactName": "SnapJoy-${version}-Windows-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
