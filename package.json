{
  "name": "snapjoy",
  "version": "1.1.1",
  "description": "SnapJoy 拾光相机 · 在电脑上留下一点好心情",
  "author": "ShellLayer",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ShellLayer/snapjoy.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win portable --x64",
    "sync-vendor": "node tools/sync-vendor.cjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "studio.lumi.booth",
    "productName": "拾光相机",
    "directories": {
      "output": "release/1.1.1"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "SnapJoy-1.1.1-Windows.exe"
    }
  }
}
